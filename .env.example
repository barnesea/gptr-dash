OPENAI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
XQUIK_API_KEY=
GETXAPI_API_KEY=
DOC_PATH=./my-docs

# Local LLM defaults via llama-swap. If FAST_LLM, SMART_LLM, and
# STRATEGIC_LLM are unset, GPT Researcher will call ${LLAMA_SWAP_URL}/running
# and use the currently running chat-serving model for all three roles.
# In Docker, host.docker.internal points back to the host machine.
LLAMA_SWAP_URL=http://host.docker.internal:8080
LLAMA_SWAP_ENABLED=true
LLAMA_SWAP_TIMEOUT=1.0
GPTR_LLAMA_SWAP_ALIAS_SUFFIX=gptr
# Optional asymmetric-retrieval instruction. Leave blank for models that do
# not require a query instruction; document embeddings are always unchanged.
EMBEDDING_QUERY_INSTRUCTION=
# Optional separate OpenAI-compatible embedding endpoint. This permits a vLLM
# pooling server for embeddings while chat continues through llama-swap.
EMBEDDING_OPENAI_BASE_URL=
# Native asymmetric formats, e.g. Jina v5 retrieval uses Query: / Document: .
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# FAST_LLM=openai:your-model-id
# SMART_LLM=openai:your-model-id
# STRATEGIC_LLM=openai:your-model-id
# OPENAI_BASE_URL=http://host.docker.internal:8080/v1

# GPT Researcher MCP server
MCP_TRANSPORT=sse
MCP_PORT=8001

# Komodo homelab compose
GPTR_STATE_ROOT=/home/pichiad/pichiciego-homelab/state/config/gptr-dash
GPTR_BACKEND_PORT=8000
GPTR_WEBUI_PORT=3000
GPTR_MCP_PORT=8001
GPTR_MCP_TRANSPORT=streamable-http
GPTR_MCP_PATH=/mcp
GPTR_MCP_MAX_CONCURRENT_DEEP_RESEARCH=1
GPTR_MCP_DEEP_RESEARCH_COOLDOWN_SECONDS=300
GPTR_MCP_ENABLE_RECURSIVE_DEEP_RESEARCH=true
GPTR_MCP_DEEP_RESEARCH_MAX_DEPTH=2
GPTR_MCP_DEEP_RESEARCH_MAX_BREADTH=3
GPTR_DEEP_RESEARCH_FOCUSED_RETRIEVAL=true
# Optional independent policy controls for evaluation. "auto" preserves the
# compatibility switch above; explicit values permit the 2x2 trajectory matrix.
GPTR_DEEP_RESEARCH_TREE_POLICY=auto
GPTR_DEEP_RESEARCH_BRANCH_MODE=auto
GPTR_DEEP_RESEARCH_MAX_DEEPENED_BRANCHES=1
GPTR_DEEP_RESEARCH_MIN_DEEPENING_SCORE=8
GPTR_DEEP_RESEARCH_SOURCE_STANDARDS=true
GPTR_DEEP_RESEARCH_DIRECT_URL_SEED=true
GPTR_SOURCE_SELECTOR_MODE=auto
GPTR_RESEARCH_TRAJECTORY_ENABLED=true
GPTR_RESEARCH_TRAJECTORY_BACKEND_DIR=/usr/src/app/data/trajectories
GPTR_RESEARCH_TRAJECTORY_MCP_DIR=/app/data/trajectories
# The public deep-research budget is a duration. Production executes the
# calculated policy; use shadow or off for immediate rollback.
GPTR_RESEARCH_DURATION_CONTROLLER_MODE=enabled
GPTR_RESEARCH_DURATION_DEFAULT_SECONDS=60
GPTR_RESEARCH_BUDGET_CALIBRATION_ENABLED=true
GPTR_RESEARCH_BUDGET_CALIBRATION_MIN_SAMPLES=10
GPTR_DEEP_RESEARCH_ADAPTIVE_COMPRESSION=true
GPTR_DEEP_RESEARCH_SIMILARITY_RESCUE_FLOOR=0.30
GPTR_DEEP_RESEARCH_MAX_CONTEXT_CHUNKS=10
GPTR_DEEP_RESEARCH_MAX_CHUNKS_PER_SOURCE=3
GPTR_DEEP_RESEARCH_FALLBACK_CORROBORATION_ENABLED=true
GPTR_DEEP_RESEARCH_FALLBACK_CORROBORATION=2
GPTR_DEEP_RESEARCH_PDF_CONNECT_TIMEOUT_SECONDS=3
GPTR_DEEP_RESEARCH_PDF_TOTAL_TIMEOUT_SECONDS=8
GPTR_DEEP_RESEARCH_PDF_MAX_BYTES=33554432
OPENWEBUI_EVENTS_ENABLED=true
OPENWEBUI_BASE_URL=http://open-webui:9090
OPENWEBUI_API_KEY=
OPENWEBUI_EVENT_TIMEOUT_S=5
GPTR_RETRIEVER=searx
GPTR_SEARXNG_URL=http://searxng:8080
GPTR_SEARX_URL=http://searxng:8080
GPTR_SCRAPER=crawl4ai
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_FILTER=fit
CRAWL4AI_TIMEOUT_S=90
CRAWL4AI_MAX_CONTENT_CHARS=0
# Evidence-grounded planning and bounded pre-scrape curation. The homelab
# compose profile enables these; set either boolean false for legacy behavior.
GPTR_PLANNING_EVIDENCE_ENABLED=true
GPTR_PLANNING_SEARCH_RESULTS=8
GPTR_PRE_SCRAPE_SOURCE_CURATION=true
GPTR_PRE_SCRAPE_MAX_SOURCES_PER_QUERY=3
GPTR_POST_SCRAPE_SOURCE_INTEGRITY=true
GPTR_SOURCE_CURATION_POLICY=balanced
# Generalized v2 retrieval. Set legacy for immediate rollback.
GPTR_RETRIEVAL_PIPELINE_MODE=v2
GPTR_SOURCE_EVIDENCE_JUDGE_MODE=all
GPTR_SOURCE_EVIDENCE_JUDGE_FALLBACK=hybrid
GPTR_CANONICAL_CONTENT_RESOLUTION=true
# Return the cited GPT Researcher report from deep_research itself. This keeps
# ephemeral IDs out of the chat model and avoids a second report-tool call.
GPTR_MCP_DEEP_RESEARCH_RETURN_REPORT=true
GPTR_MCP_EXPOSE_RESEARCH_ID=false

# Server-side backend URL for the Next.js container.
# GPTR_API_URL=http://gpt-researcher:8000
# NEXT_PUBLIC_GPTR_API_URL=http://0.0.0.0:8000  # Defaults to localhost:8000 if not set

# Scraper Configuration
# ---------------------
# Control concurrent scraping and rate limiting to respect API limits

# Maximum concurrent scraper workers (simultaneous operations)
# Adjust based on your scraper service limits:
#   - Firecrawl Free: 2 concurrent browsers
#   - Firecrawl Hobby: 5 concurrent browsers
#   - BeautifulSoup/other scrapers: Set based on target site limits
# Default: 15 (may be too high for rate-limited APIs)
#MAX_SCRAPER_WORKERS=15

# Rate limiting: minimum seconds between scraper requests
# Controls request frequency to avoid exceeding API rate limits
# Calculate as: 60 / requests_per_minute
# Examples:
#   - Firecrawl Free (10 req/min): 6.0 seconds
#   - Firecrawl /scrape (10 req/min): 6.0 seconds
#   - Custom API (30 req/min): 2.0 seconds
#   - No rate limit: 0 (default)
# Note: Works with all scrapers (firecrawl, bs, browser, etc.)
# Default: 0.0 (no rate limiting)
#SCRAPER_RATE_LIMIT_DELAY=0.0

# Performance Optimization
# ------------------------
# Smart context compression: Skip expensive embedding-based filtering for small documents
# When scraped content is already concise, directly use it instead of running compression pipeline
# This can reduce latency by 40-50% for queries with small result sets
# Default: 8000 characters (8KB threshold)
#COMPRESSION_THRESHOLD=8000

# LangChain Tracing (LangSmith) - Enable for enhanced observability
# To enable tracing, uncomment the following lines and provide your API Key

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT="gpt-researcher"

# Token Limits
# ------------
# Maximum output tokens per LLM call. Leaving unset uses package defaults
# (FAST=6000, SMART=12000, STRATEGIC=8000) suited to GPT-5-class models.
# Modern long-output models (Claude 4.x, GPT-5) truncate reports at
# these defaults.
#
# Recommended values by model class:
#   GPT-4o family (16k max output):   SMART_TOKEN_LIMIT=8000
#   Claude Haiku 4.5 (64k max):       SMART_TOKEN_LIMIT=16000
#   Claude Sonnet 4.6 (64k max):      SMART_TOKEN_LIMIT=16000
#   Claude Opus 4.7 (128k max):       SMART_TOKEN_LIMIT=32000
#   GPT-5 family (128k max):          SMART_TOKEN_LIMIT=32000
#
# FAST_TOKEN_LIMIT=8000
# SMART_TOKEN_LIMIT=16000
# STRATEGIC_TOKEN_LIMIT=16000
GROUNDROUTE_API_KEY=
